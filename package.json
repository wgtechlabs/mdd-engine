{
  "name": "@wgtechlabs/mdd-engine",
  "version": "0.1.1",
  "description": "Headless Markdown documentation compiler for mdd",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wgtechlabs/mdd-engine.git"
  },
  "homepage": "https://github.com/wgtechlabs/mdd-engine#readme",
  "bugs": "https://github.com/wgtechlabs/mdd-engine/issues",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.10",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome check src tests scripts package.json tsconfig.json tsconfig.build.json biome.json",
    "format": "biome check --write src tests scripts package.json tsconfig.json tsconfig.build.json biome.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke.mjs",
    "check": "bun run lint && bun run typecheck && bun test && bun run build && bun run smoke"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22",
    "typescript": "7.0.2"
  }
}
